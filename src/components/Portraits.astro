---
import BookPair from './BookPair.astro';
import { dims, lookFilters, looks } from '../data/gallery';
import { site } from '../data/site';
import SectionHead from './SectionHead.astro';

const INITIAL = 16;
const counts = Object.fromEntries(
  lookFilters.map((f) => [f.id, f.id === 'all' ? looks.length : looks.filter((l) => l.tags.includes(f.id)).length]),
);
---

<!-- The darkroom: the whole site turns to red safelight and the portraits develop as they arrive. -->
<section id="portraits" data-edition="darkroom" data-darkroom class="mx-auto max-w-[1400px] scroll-mt-16 px-4 pb-32 pt-24 sm:px-6">
  <div class="mb-8 flex flex-col items-center gap-3" aria-hidden="true">
    <span class="h-10 w-px bg-ink-soft/50"></span>
    <span class="safelight block size-7 rounded-full"></span>
  </div>
  <SectionHead page={5} title="Society Pages" aside="Our work" />

  <!-- the style index: set like a printed index line, not a row of buttons -->
  <div class="mt-8 text-center">
    <p data-rise class="font-deck text-xl italic text-ink-soft">Fresh from the chairs. Pick a style.</p>
    <div data-rise class="style-index mx-auto mt-4 max-w-4xl" role="group" aria-label="Filter by style" data-look-filters>
      {
        lookFilters.map((f, i) => (
          <button type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}<sup>{counts[f.id]}</sup>
          </button>
        ))
      }
    </div>
  </div>

  <div class="mt-10 gap-5 columns-2 md:columns-3 lg:columns-4" data-look-grid>
    {
      looks.map((l, i) => (
        <figure
          class:list={['look print group mb-7 break-inside-avoid border border-ink/25 bg-[var(--frame)] p-2 pt-3 shadow-[0_18px_34px_-22px_rgb(0_0_0/0.8)]', i >= INITIAL && 'is-extra hidden']}
          data-tags={l.tags.join(' ')}
        >
          <button
            type="button"
            class="block w-full cursor-zoom-in overflow-hidden"
            data-lightbox="looks"
            data-src={l.src}
            data-caption={`No. ${String(i + 1).padStart(2, '0')}. ${l.caption}`}
            aria-label={`Enlarge: ${l.caption}`}
          >
            <img
              src={l.src}
              {...dims(l.src)}
              alt={`Client portrait: ${l.caption}`}
              loading="lazy"
              class="h-auto w-full sepia-[.12] transition duration-700 group-hover:scale-[1.03] group-hover:sepia-0"
            />
          </button>
        </figure>
      ))
    }
  </div>

  <div class="mt-10 flex flex-wrap items-center justify-center gap-4 border-t border-ink/40 pt-10">
    <button type="button" data-look-more class="border-2 border-ink px-7 py-3 font-display text-xl font-bold uppercase transition hover:bg-ink hover:text-paper">
      Show all {looks.length} portraits
    </button>
    <BookPair label="Book the look" />
  </div>
</section>
