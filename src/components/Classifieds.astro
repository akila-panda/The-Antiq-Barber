---
import FloatingTools from './FloatingTools.astro';
import { bookHref, serviceGroups, site } from '../data/site';
import BookPair from './BookPair.astro';
import SectionHead from './SectionHead.astro';

const [lead, ...others] = serviceGroups.flatMap((g) => g.items).filter((s) => s.popular);

---

<section id="classifieds" data-edition="day" class="relative mx-auto max-w-[1400px] scroll-mt-16 px-4 pt-20 sm:px-6">
  <FloatingTools items={[{ tool: 'scissors', x: '-8%', y: '8%', size: 1.1, rotate: -20, speed: 1.4 }, { tool: 'comb', x: '101%', y: '30%', size: 1, rotate: 12, speed: 0.8 }, { tool: 'tin', x: '-7.5%', y: '74%', size: 0.9, rotate: 8, speed: 1.1 }]} />
  <SectionHead title="Services" />

  <!-- booking, said once and plainly -->
  <div data-rise class="mt-8 flex flex-col gap-5 border-b border-ink pb-8 md:flex-row md:items-center md:justify-between">
    <p class="max-w-xl font-deck text-[clamp(1.4rem,2.2vw,1.9rem)] italic leading-snug">
      Book direct with the shop, use Booksy if you're on it already, or walk straight in. Cuts from $40.
    </p>
    <div class="flex flex-wrap items-center gap-5">
      <BookPair size="lg" />
      <a href={site.phoneHref} class="text-lg underline decoration-oxblood underline-offset-4 hover:text-oxblood">Call {site.phone}</a>
    </div>
  </div>

  <!-- most booked: one lead ad, two smaller ones -->
  <div class="mt-10 grid gap-5 lg:grid-cols-[1.35fr_1fr]">
    <div data-rise class="flex flex-col justify-between bg-ink p-7 text-paper sm:p-9">
      <p class="font-deck text-xl italic text-paper/80">Most booked at the shop</p>
      <h3 class="mt-4 font-display text-[clamp(2.4rem,4.5vw,3.8rem)] font-black uppercase leading-[0.9]">{lead.name}</h3>
      <div class="mt-8 flex items-end justify-between gap-4 border-t border-paper/30 pt-5">
        <p class="num font-display text-[clamp(3rem,6vw,4.5rem)] font-bold leading-none">{lead.price}</p>
        <p class="text-right">
          <span class="block font-deck text-lg italic text-paper/80">{lead.duration}</span>
          <a href={bookHref({ service: lead.name })} class="mt-2 inline-block bg-paper px-4 py-2 font-display text-lg font-bold uppercase text-ink transition hover:bg-gold">Book this →</a>
          <a href={site.booksyUrl} target="_blank" rel="noopener" class="mt-2 block font-deck text-base italic text-paper/75 hover:text-paper">or on <span class="booksy-word text-sm">Booksy</span> ↗</a>
        </p>
      </div>
    </div>
    <div class="grid gap-5">
      {
        others.map((s) => (
          <a href={bookHref({ service: s.name })} data-rise class="group flex items-center justify-between gap-4 border-2 border-ink p-6 transition hover:bg-paper-deep">
            <span>
              <span class="block font-display text-2xl font-black uppercase leading-tight">{s.name}</span>
              <span class="mt-1 block font-deck text-lg italic text-ink-soft">{s.duration} · {s.note}</span>
            </span>
            <span class="text-right">
              <span class="num block font-display text-3xl font-bold text-oxblood">{s.price}</span>
              <span class="mt-1 inline-block border-b border-ink font-display text-sm font-bold uppercase group-hover:text-oxblood">Book</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <!-- the full menu: every service bookable from its own line -->
  <div class="mt-10 grid items-start gap-5 lg:grid-cols-3">
    {
      serviceGroups.map((g, gi) => (
        <div data-rise class:list={['border border-ink p-5', gi === 0 && 'lg:row-span-2']}>
          <h3 class="border-b border-ink pb-2 font-display text-xl font-bold">{g.title}</h3>
          <ul class="divide-y divide-ink/20">
            {g.items.map((s) => (
              <li class="flex items-center gap-3 py-3">
                <div class="min-w-0 flex-1">
                  <p class="font-display text-lg font-bold leading-tight">{s.name}</p>
                  <p class="font-deck italic text-ink-soft">{s.duration}</p>
                </div>
                <span class="num font-display text-xl font-bold whitespace-nowrap">{s.price}</span>
                <a
                  href={bookHref({ service: s.name })}
                  class="shrink-0 border border-ink px-3 py-1.5 font-display text-sm font-bold uppercase transition hover:bg-ink hover:text-paper"
                  aria-label={`Book ${s.name}`}
                >
                  Book
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <!-- house notices -->
    <div class="border-4 border-double border-ink p-6 text-center lg:col-span-2 sm:p-8">
      <p data-split class="font-display text-[clamp(2.2rem,4vw,3.2rem)] font-bold leading-none">House Notices</p>
      <!-- centred rows (4 then 3 on wide screens) so an odd count never leaves a gap -->
      <ul class="mt-6 flex flex-wrap justify-center">
        {
          site.amenities.map((a) => (
            <li data-rise class="w-full border-t border-dashed border-ink/40 px-4 py-5 sm:w-1/2 lg:w-1/4">
              <span class="block font-deck text-[clamp(1.8rem,2.6vw,2.3rem)] italic leading-none">{a.label}</span>
              <span class="mt-2 block font-deck text-lg italic text-ink-soft">{a.line}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
