---
import BookPair from './BookPair.astro';
import { site } from '../data/site';
---

<!-- Dawn: today's paper lands on the dark doorstep, unfolds, and becomes the day.
     The front page is drawn twice and clipped into top and bottom halves so the top
     half can fold over like a real broadsheet. Colours are fixed so they never depend
     on the edition; the whole site switches back to day once the paper is open. -->
<section id="dawn" data-edition="day" data-edition-start="top -95%" class="relative">
  <div data-dawn-stage class="relative h-[100svh] overflow-hidden bg-[#eadcbf]">
    <!-- the dark doorstep, fading out as the paper opens -->
    <div data-dawn-dark class="absolute inset-0 bg-[#1a0506]" aria-hidden="true"></div>

    <div data-paper class="absolute inset-0 [perspective:2400px]">
      <div data-paper-sheet class="absolute inset-0 shadow-[0_40px_80px_-20px_rgb(0_0_0/0.7)]">
        {
          ['top', 'bottom'].map((half) => (
            <div
              data-paper-half={half}
              class:list={['absolute inset-x-0 h-1/2 overflow-hidden bg-[#eadcbf]', half === 'top' ? 'top-0 origin-bottom' : 'bottom-0']}
            >
              <div
                data-paper-front={half}
                class:list={['absolute inset-x-0 h-[200%] text-[#16120e]', half === 'top' ? 'top-0' : '-top-full']}
                aria-hidden={half === 'top' ? 'true' : undefined}
              >
                <div class="mx-auto flex h-full max-w-[1100px] flex-col px-6 pb-[6vh] pt-[11vh] text-center">
                  <div class="kicker flex justify-between gap-3 border-b border-[#16120e] pb-2 text-[#4b4136]">
                    <span>Today's edition</span>
                    <span data-today class="hidden sm:inline">Today</span>
                    <span>Epping</span>
                  </div>
                  <p class="mt-[2vh] font-black text-[clamp(2.4rem,7vw,5.5rem)] leading-none [text-shadow:none]">The Antiq Barber</p>
                  <div class="rule-double mt-[2vh]"></div>
                  <div class="flex flex-1 flex-col items-center justify-center">
                    <p class="mt-3 font-display text-[clamp(3rem,9vw,7.5rem)] font-black uppercase leading-[0.86] tracking-[-0.02em] text-[#16120e] [text-shadow:none]">
                      Good day,<br />Epping.
                    </p>
                    <p class="kicker mt-5 text-[#8e1b1b]" data-open-status>Walk-ins welcome</p>
                    <BookPair variant="stamp" label="Book a chair" class="mt-6 text-[#8e1b1b]" />
                  </div>
                </div>
              </div>
              {
                half === 'top' && (
                  <div
                    data-paper-back
                    class="pointer-events-none absolute inset-0 grid place-items-center bg-[#e2d1ad] [transform:rotateX(180deg)]"
                    aria-hidden="true"
                  >
                    <div
                      class="absolute inset-[8%] opacity-60"
                      style="background: repeating-linear-gradient(180deg, transparent 0 12px, rgb(22 18 14 / .14) 12px 14px), linear-gradient(90deg, transparent 32%, rgb(22 18 14 / .25) 32% calc(32% + 1px), transparent calc(32% + 1px) 66%, rgb(22 18 14 / .25) 66% calc(66% + 1px), transparent calc(66% + 1px));"
                    >
                    </div>
                    <p class="relative bg-[#e2d1ad] px-4 font-black text-[clamp(1.8rem,5vw,3.5rem)] text-[#16120e]/70">Today's Edition</p>
                  </div>
                )
              }
            </div>
          ))
        }
        <!-- the crease -->
        <div data-paper-crease class="pointer-events-none absolute inset-x-0 top-1/2 h-px bg-[#16120e]/30 shadow-[0_0_16px_2px_rgb(0_0_0/0.3)]" aria-hidden="true"></div>
      </div>
    </div>

    <p data-dawn-hint class="kicker absolute inset-x-0 bottom-6 text-center text-[#e9d9b4]/70">Today's paper has arrived · keep scrolling</p>
  </div>
</section>
