---
import BookPair from './BookPair.astro';
import FloatingTools from './FloatingTools.astro';
import { fmtTime, hours, site } from '../data/site';
import SectionHead from './SectionHead.astro';

const { address } = site;
const mapEmbed = 'https://www.google.com/maps?q=Antiq+Barbers,+5/60+Miller+St,+Epping+VIC+3076,+Australia&output=embed';
// Illustrative route only: the map is a decorative engraving, not a street plan.
const route = 'M70,360 C140,330 150,260 230,250 S330,280 360,210 S420,120 470,130';
---

<section id="directions" data-edition="day" class="relative mx-auto max-w-[1400px] scroll-mt-16 px-4 pt-20 sm:px-6">
  <FloatingTools items={[{ tool: 'razor', x: '101%', y: '12%', size: 1.15, rotate: -14, speed: 1.3 }]} />
  <SectionHead page={7} title="Directions" aside="Find us" />

  <div class="grid gap-10 pt-10 lg:grid-cols-12">
    <!-- the map: our engraving by default, the real Google map one tap away -->
    <figure data-rise class="lg:col-span-7" data-map>
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex gap-3" role="group" aria-label="Map style">
          <button type="button" class="nav-ticket nav-ticket-sm" data-map-tab="drawn" aria-current="true">
            <span class="stub">✎</span><span class="label">Illustrated</span>
          </button>
          <button type="button" class="nav-ticket nav-ticket-sm" data-map-tab="google">
            <span class="stub">⌖</span><span class="label">Google Maps</span>
          </button>
        </div>
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="underline decoration-oxblood underline-offset-4 hover:text-oxblood">Open in Google Maps ↗</a>
      </div>
      <div class="clip-box relative bg-paper-deep/40 p-3" data-map-panel="drawn">
        <svg viewBox="0 0 600 420" class="block w-full" role="img" aria-label="Illustrated map: a dashed route to Antiq Barbers on Miller Street, Epping">
          <defs>
            <pattern id="hatch" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
              <line x1="0" y1="0" x2="0" y2="8" stroke="#16120e" stroke-opacity=".18" stroke-width="1"></line>
            </pattern>
            <mask id="route-mask" maskUnits="userSpaceOnUse">
              <path data-route-mask d={route} stroke="#fff" stroke-width="12" fill="none" stroke-linecap="round"></path>
            </mask>
          </defs>

          <!-- blocks -->
          <g fill="url(#hatch)" stroke="#16120e" stroke-opacity=".5">
            <rect x="40" y="40" width="150" height="120"></rect>
            <rect x="220" y="40" width="190" height="60"></rect>
            <rect x="440" y="180" width="130" height="190"></rect>
            <rect x="250" y="300" width="160" height="80"></rect>
            <rect x="40" y="190" width="130" height="90"></rect>
          </g>

          <!-- Miller Street -->
          <path d="M0,150 L600,110" stroke="#16120e" stroke-width="22" stroke-opacity=".12"></path>
          <path d="M0,150 L600,110" stroke="#16120e" stroke-width="1"></path>
          <text x="210" y="122" transform="rotate(-3.8 210 122)" style="font-family: var(--font-deck); font-style: italic; font-size: 22px;" fill="#16120e">Miller Street</text>

          <!-- route -->
          <path data-route d={route} stroke="#8e1b1b" stroke-width="3" stroke-dasharray="9 8" fill="none" mask="url(#route-mask)"></path>
          <circle cx="70" cy="360" r="6" fill="#16120e"></circle>
          <text x="84" y="390" style="font-family: var(--font-mono); font-size: 12px; letter-spacing: 2px;" fill="#4b4136">YOU, NOW</text>

          <!-- X marks the chair -->
          <g transform="translate(470 130)">
            <circle r="24" fill="#ebe1ca" stroke="#8e1b1b" stroke-width="2"></circle>
            <path d="M-9,-9 L9,9 M9,-9 L-9,9" stroke="#8e1b1b" stroke-width="3.5" stroke-linecap="round"></path>
          </g>
          <text x="470" y="176" text-anchor="middle" style="font-family: var(--font-display); font-weight: 800; font-size: 20px;" fill="#16120e">ANTIQ</text>
          <text x="470" y="194" text-anchor="middle" style="font-family: var(--font-mono); font-size: 11px; letter-spacing: 1.5px;" fill="#4b4136">5/60 MILLER ST</text>

          <text x="20" y="410" style="font-family: var(--font-mono); font-size: 10px; letter-spacing: 2px;" fill="#4b4136">NOT TO SCALE</text>
          <!-- compass -->
          <g transform="translate(540 60)" fill="#16120e">
            <circle r="26" fill="none" stroke="#16120e" stroke-opacity=".6"></circle>
            <path d="M0,-34 L6,0 L0,6 L-6,0 Z"></path>
            <path d="M0,34 L6,0 L0,-6 L-6,0 Z" fill-opacity=".3"></path>
            <text y="-40" text-anchor="middle" style="font-family: var(--font-display); font-weight: 700; font-size: 14px;">N</text>
          </g>
        </svg>
      </div>
      <div class="clip-box relative hidden bg-paper-deep/40 p-3" data-map-panel="google">
        <iframe
          title="Google map: Antiq Barbers, 5/60 Miller St, Epping VIC 3076"
          data-src={mapEmbed}
          class="block aspect-[600/420] w-full border-0 [filter:sepia(.25)_saturate(.9)]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </figure>

    <!-- particulars -->
    <div class="lg:col-span-5 lg:border-l lg:border-ink/40 lg:pl-10">
      <p data-split class="font-display text-[clamp(2.4rem,4.5vw,3.6rem)] font-extrabold uppercase leading-[0.9]">
        Find the shop
      </p>
      <dl data-rise class="mt-8 divide-y divide-ink/30 border-y border-ink">
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="pt-0.5 font-display text-lg font-bold text-oxblood">Address</dt>
          <dd class="font-serif text-xl leading-snug">
            {address.line1}<br />{address.suburb} {address.state} {address.postcode}
          </dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="pt-0.5 font-display text-lg font-bold text-oxblood">Hours</dt>
          <dd class="font-serif text-lg leading-snug">
            <p data-open-status class="kicker mb-2 inline-block border border-ink px-2 py-1">Walk-ins welcome</p>
            <ul>
              {
                hours.map((h) => (
                  <li data-hours-day={h.day} class="flex justify-between gap-4 py-0.5">
                    <span>{h.label}</span>
                    <span class="text-ink-soft">{h.open && h.close ? `${fmtTime(h.open)} – ${fmtTime(h.close)}` : 'Closed'}</span>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="pt-0.5 font-display text-lg font-bold text-oxblood">Telephone</dt>
          <dd class="font-serif text-xl">
            <a href={site.phoneHref} class="underline decoration-oxblood">{site.phone}</a>
          </dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="pt-0.5 font-display text-lg font-bold text-oxblood">Email &amp; social</dt>
          <dd class="font-serif text-lg leading-relaxed">
            <a href={`mailto:${site.email}`} class="underline decoration-oxblood">{site.email}</a><br />
            <a href={site.instagram} target="_blank" rel="noopener" class="underline decoration-oxblood">{site.instagramHandle}</a> ·
            <a href={site.facebook} target="_blank" rel="noopener" class="underline decoration-oxblood">Facebook</a>
          </dd>
        </div>
      </dl>
      <div class="mt-8 flex flex-wrap items-center gap-6">
        <BookPair />
        <a href={site.mapsUrl} target="_blank" rel="noopener" class="kicker border-b border-ink pb-0.5 hover:text-oxblood">
          Get directions ↗
        </a>
      </div>
    </div>
  </div>
</section>
